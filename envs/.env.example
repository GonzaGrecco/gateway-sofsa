# Completar por ambiente (dev / test / prod). No commitear el .env real.

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-CAMBIAR
LITELLM_SALT_KEY=sk-CAMBIAR          # NO cambiar una vez cargadas credenciales: se pierden
DATABASE_URL=postgresql://litellm:CAMBIAR@HOST:5432/litellm
PROXY_BASE_URL=https://litellm.CAMBIAR-dominio-sofsa

# --- Redis (rate limits compartidos entre instancias) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Proveedor (Item B3) ---
ANTHROPIC_API_KEY=

# --- Langfuse (claves del proyecto, se generan en su consola) ---
LANGFUSE_HOST=https://langfuse.CAMBIAR-dominio-sofsa
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- OpenTelemetry (collector de SOFSA) ---
OTEL_EXPORTER=otlp_http              # otlp_grpc si el collector solo expone 4317
OTEL_ENDPOINT=http://CAMBIAR-collector:4318
OTEL_HEADERS=                        # opcional, ej: Authorization=Bearer xxx
OTEL_SERVICE_NAME=litellm-gateway-CAMBIAR-ambiente

# --- Consola web: usuario propio, así nadie entra con la master key ---
UI_USERNAME=admin
UI_PASSWORD=CAMBIAR

# --- SSO OIDC con el IdP de SOFSA (hasta 5 admins en LiteLLM) ---
# Descomentar recién con los datos del IdP: definidas aunque sea vacías, LiteLLM da el SSO por
# configurado y la consola redirige a un login que no existe.
# GENERIC_CLIENT_ID=
# GENERIC_CLIENT_SECRET=
# GENERIC_AUTHORIZATION_ENDPOINT=
# GENERIC_TOKEN_ENDPOINT=
# GENERIC_USERINFO_ENDPOINT=
