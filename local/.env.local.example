# Copiar a local/.env  (cp .env.local.example .env). Valores solo para pruebas locales.
LITELLM_MASTER_KEY=sk-local-master-1234
LITELLM_SALT_KEY=sk-local-salt-1234
DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=localredis

# Usuario de la consola web (http://localhost:4001/ui) mientras no haya SSO
UI_USERNAME=admin
UI_PASSWORD=admin-local

# Langfuse local (local/langfuse/docker-compose.yml, UI en http://localhost:3002)
LANGFUSE_HOST=http://host.docker.internal:3002
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# OpenTelemetry -> Jaeger del compose (UI en http://localhost:16686)
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=litellm-gateway-local

# Anthropic real (opcional, gasta): solo para los modelos *-real de config.local.yaml
ANTHROPIC_API_KEY=
