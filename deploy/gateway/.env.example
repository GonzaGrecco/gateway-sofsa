COMPOSE_PROJECT_NAME=gateway-prod     # gateway-dev / gateway-test en VM 4
ENV_FILE=prod.env
# CONFIG_FILE=config.local.yaml       # modelos mock, para la notebook
HTTP_PORT=80                          # en VM 4, distinto para dev y test

# Empiezan con sk-. VM 1 y VM 2 usan las mismas: si no, VM 2 no lee las credenciales.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=                    # NO cambiar una vez cargadas credenciales: se pierden
PROXY_BASE_URL=

POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATOS_IP=127.0.0.1                   # VM 1: su IP privada, para que llegue VM 2
POSTGRES_HOST_PORT=5432              # en VM 4, distinto para dev y test
REDIS_HOST_PORT=6379                 # en VM 4, distinto para dev y test

# VM 2 apunta a la IP de VM 1, nunca a los locales: con bases separadas, una key creada en un nodo
# da 401 en el otro y los presupuestos se duplican.
DB_HOST=postgres
REDIS_HOST=redis
REDIS_PORT=6379

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Sin usuario propio, a la consola se entra con la master key.
UI_USERNAME=
UI_PASSWORD=
