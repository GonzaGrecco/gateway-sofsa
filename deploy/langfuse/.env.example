# Guardar una copia de SALT y ENCRYPTION_KEY fuera de la VM: sin ellas no se leen los datos cifrados.

COMPOSE_PROJECT_NAME=langfuse-prod        # langfuse-noprod en VM 4
WEB_PORT=3000
NEXTAUTH_URL=
# LANGFUSE_VERSION=4.64.0                 # actualizar primero en VM 4, después en VM 3

NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=                           # 64 caracteres hex: openssl rand -hex 32

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

INIT_ORG_ID=prod                          # dev en VM 4 (la de test se crea desde la consola)
ADMIN_EMAIL=
ADMIN_PASSWORD=
